{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "types": [],
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "react": ["./node_modules/preact/compat/"],
      "react-dom": ["./node_modules/preact/compat/"],
      "react-dom/client": ["./node_modules/preact/compat/client"],
      "react/jsx-runtime": ["./node_modules/preact/jsx-runtime"],
      "react/jsx-dev-runtime": ["./node_modules/preact/jsx-dev-runtime"]
    }
  },
  "include": [
    "src/webview/sidebar/**/*.ts",
    "src/webview/sidebar/**/*.tsx",
    "src/webview/activity/**/*.ts",
    "src/webview/activity/**/*.tsx",
    "src/webview/pin-studio/**/*.ts",
    "src/webview/pin-studio/**/*.tsx",
    "src/webview/handoff/**/*.ts",
    "src/webview/handoff/**/*.tsx",
    "src/webview/inspector/**/*.ts",
    "src/webview/inspector/**/*.tsx",
    "src/webview/plugins/**/*.ts",
    "src/webview/plugins/**/*.tsx",
    "src/webview/shared/ui/**/*.ts",
    "src/webview/shared/ui/**/*.tsx",
    "src/webview/agent-studio/**/*.ts",
    "src/webview/agent-studio/**/*.tsx",
    "src/webview/rich-doc/**/*.ts",
    "src/webview/rich-doc/**/*.tsx",
    "src/webview/task-studio/**/*.ts",
    "src/webview/task-studio/**/*.tsx",
    "src/webview/runtime-ops/**/*.ts",
    "src/webview/runtime-ops/**/*.tsx",
    "src/webview/ui-gate/**/*.ts",
    "src/webview/ui-gate/**/*.tsx",
    "src/webview/shared/studio/protocol.ts",
    "src/webview/shared/studio/errorTaxonomy.ts",
    "src/webview/shared/studio/dirtyGating.ts",
    "src/webview/shared/studio/restoreDecisions.ts",
    "src/webview/shared/studio/adapter.ts",
    "src/webview/shared/studio/StudioFrame.tsx",
    "src/webview/pipeline-studio/**/*.ts",
    "src/webview/pipeline-studio/**/*.tsx",
    "src/webview/agent-studio-fixture/**/*.ts",
    "src/webview/agent-studio-fixture/**/*.tsx",
    "scripts/webview-preview/**/*.ts",
    "types/**/*.d.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
