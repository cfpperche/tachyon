{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "types": [],
    "noEmit": true
  },
  "include": [
    "src/webview/sidebar/**/*.ts",
    "src/webview/sidebar/**/*.tsx",
    "src/webview/activity/**/*.ts",
    "src/webview/activity/**/*.tsx",
    "src/webview/pin-studio/**/*.ts",
    "src/webview/pin-studio/**/*.tsx",
    "src/webview/handoff/**/*.ts",
    "src/webview/handoff/**/*.tsx",
    "src/webview/inspector/**/*.ts",
    "src/webview/inspector/**/*.tsx",
    "src/webview/plugins/**/*.ts",
    "src/webview/plugins/**/*.tsx",
    "src/webview/shared/ui/**/*.ts",
    "src/webview/shared/ui/**/*.tsx",
    "src/webview/agent-studio/**/*.ts",
    "src/webview/agent-studio/**/*.tsx",
    "src/webview/rich-doc/**/*.ts",
    "src/webview/rich-doc/**/*.tsx",
    "scripts/webview-preview/**/*.ts",
    "types/**/*.d.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
