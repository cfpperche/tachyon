# tachyon.yml.example — shared template for THIS monorepo dogfood fleet.
#
# Live config is gitignored. Create/edit locally:
#   cp tachyon.yml.example tachyon.yml
#
# Backup (this machine): ~/.local/share/tachyon-backups/tachyon.yml.latest
# Format: https://github.com/cfpperche/tachyon

agents:
  hermes:
    cmd: hermes

settings:
  auth: true # require a Bearer token on the MCP Bridge (recommended)
  projectGuidance:
    files:
      - docs/project-guidance.md
  # Orchestrated waves (impl + reviewers + declared fleet) need headroom above default 8.
  maxAgents: 12
  # t-e4f662 — how long something may wait in Control -> Inbox before it is MARKED stale. Display
  # only: nothing here approves, denies or closes anything. Default 24; `never` stops the marking for
  # a fleet that parks work on purpose (a mark that is always on has stopped being a signal).
  humanInbox:
    staleAfterHours: 24
  # Coordinators allowed to record integration or prune linked GitDelivery projections.
  gitDelivery:
    prunePrincipals: [ hermes, grok, claude, codex ]
    integratePrincipals: [ hermes, claude ]
  # specs 362/385 — this repository's explicit verify_task commands/adapter (no product-global runner defaults):
  # full builds dist/ first (the plugin-ui full-stack topology needs bundles; a fresh worktree has none).
  verify:
    full: npm run verify:full:quiet
    typecheck: npm run typecheck
    prepare: npm run verify:prepare
    affected: npx vitest related --run
    behavior:
      adapter: vitest-name
      command: npm test --
      # Compatibility key: this names a pre-existing tracked project oracle; Tachyon never generates it.
      stubPath: test/unit/{agent}Behavior.gen.test.ts
      # These tracked files define dependency and runner mechanics; their spawn hashes must match BASE/HEAD.
      executorPaths: [ package.json, package-lock.json, vitest.config.ts, tsconfig.json ]
  # worktree:
  #   branch: "tachyon/{agent}"   # template for per-agent worktree branch names
  # maxAgents: 8                  # fork-bomb guardrail (default 8)
