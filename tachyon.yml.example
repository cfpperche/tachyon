# tachyon.yml.example — shared template for THIS monorepo dogfood fleet.
#
# Live config is gitignored. Create/edit locally:
#   cp tachyon.yml.example tachyon.yml
#
# Format: https://github.com/cfpperche/tachyon

# t-ae221c — there is no agent roster in this file. The fleet is `.tachyon/agents/<name>/`: a
# directory with a readable `agent.yml` in it IS an agent, and nothing here declares one. Create the
# first one in Agent Studio.
#
# An older `tachyon.yml` still carries an `agents:` block. It loads, with a warning saying the block
# is ignored and can be deleted. Nothing rewrites your file for you.

settings:
  auth: true # require a Bearer token on the MCP Bridge (recommended)
  projectGuidance:
    files:
      - docs/project-guidance.md
  # Orchestrated waves (impl + reviewers + declared fleet) need headroom above default 8.
  maxAgents: 12
  # t-e4f662 — how long something may wait in Control -> Inbox before it is MARKED stale. Display
  # only: nothing here approves, denies or closes anything. Default 24; `never` stops the marking for
  # a fleet that parks work on purpose (a mark that is always on has stopped being a signal).
  humanInbox:
    staleAfterHours: 24
  # t-09edf2 — which installed plugins' hooks reach an AGENT'S OWN session, named one by one.
  #
  # An agent in its own worktree inherits nothing from the workspace unless you say so, and this key is
  # how you say so for a plugin's PreToolUse gate. It exists because `secrets-guard`'s layer 2 (the
  # shape-gate that refuses `git commit --no-verify`) lives in `.claude/settings.json` /
  # `.codex/hooks.json` of THIS checkout — files a delegated worktree does not have, and that a Claude
  # agent running with `--setting-sources user` would not read even if it did. Layer 1 (pre-commit +
  # gitleaks) is unaffected: it rides `core.hooksPath`, which every worktree already shares.
  #
  # Only `enforcement` is projected, and only on gate events (`PreToolUse`) — classification buys
  # refusal, never reach: a listed plugin still cannot push prompt text or a capability into a session.
  agentHookProjection:
    secrets-guard: enforcement
  # t-585d5c — how long a parented agent may sit idle before Tachyon nudges its parent. MINUTES.
  # Default 10, which is slow for a release cut or a wide parallel squad; lower it when you are
  # watching several children at once. `never` turns the nudge off; `0` is refused, because it reads
  # as "nudge immediately" rather than the off it resembles. Applies on the next tick — no restart
  # and no recreating agents.
  agentNotifications:
    idleAfterMinutes: 10
  # worktree:
  #   branch: "tachyon/{agent}"   # template for per-agent worktree branch names
  #   revealInWorkspace: true     # show each running agent's worktree as a folder (multi-root windows only)
  #   shareDependencies: true     # link node_modules to the primary checkout while the lockfiles match (default true)
  # maxAgents: 8                  # fork-bomb guardrail (default 8)
  # agentMemoryMax: "2G"          # opt-in systemd --user MemoryMax per agent spawn tree (Linux only)
  # taskNotifications:            # human-facing toasts for task create/edit events
  #   enabled: true
  #   events: [created, assigned, statusChanged, awaitingHuman, journalAppended]
  #   suppressOwnChanges: true
  #   dedupeWindowMs: 30000
  #
  # Per-person, per-machine settings (activity.codeTheme, agentPane.enabled, sidebar.cardTemplate,
  # gitPath) do NOT belong here — they live in ~/.tachyon/settings.json. See README -> Settings.
