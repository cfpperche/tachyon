{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "node16",
    "lib": ["ES2022"],
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@tachyon/webview-ui/*": ["packages/webview-ui/src/*"]
    }
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "types/**/*.d.ts"],
  "references": [
    { "path": "./packages/shared" },
    { "path": "./packages/engine" },
    { "path": "./packages/webview-ui" }
  ],
  "exclude": ["node_modules", "dist", ".vscode-test", "src/webview/cockpit", "src/webview/sidebar", "src/webview/activity", "src/webview/pin-studio", "src/webview/handoff", "src/webview/inspector", "src/webview/plugins", "src/webview/shared/ui", "src/webview/agent-studio", "src/webview/rich-doc", "src/webview/task-studio", "src/webview/runtime-ops", "src/webview/ui-gate", "src/webview/pipeline-studio", "src/webview/agent-studio-fixture", "src/webview/section-app-fixture", "test/browser"]
}
