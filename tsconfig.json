{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "node16",
    "lib": ["ES2022"],
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "types/**/*.d.ts"],
  "exclude": ["node_modules", "dist", ".vscode-test", "src/webview/sidebar", "src/webview/activity", "src/webview/pin-studio", "src/webview/handoff", "src/webview/inspector", "src/webview/plugins", "src/webview/shared/ui", "src/webview/agent-studio", "src/webview/rich-doc", "src/webview/task-studio", "src/webview/ui-gate", "src/webview/pipeline-studio", "test/browser"]
}
