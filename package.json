        ],
        "toolReferenceName": "tachyon_send_prompt",
        "displayName": "Tachyon: Send Prompt",
        "userDescription": "Send a prompt to a named Tachyon agent",
        "modelDescription": "Deliver text to a named Tachyon workspace agent (CLI running in a worktree via the Tachyon engine). Use when the user wants a Tachyon agent (e.g. grok, claude, codex) to act. Requires agent name and message text. Prefer list agents first if the name is unclear. This does not control the VS Code Integrated Browser; it only types into the agent session.",
        "canBeReferencedInPrompt": true,
        "icon": "$(rocket)",
        "inputSchema": {
          "type": "object",
          "properties": {
            "agent": {
              "type": "string",
              "description": "Exact Tachyon agent name (from tachyon_list_agents)."
            },
            "text": {
              "type": "string",
              "description": "Prompt text to deliver to the agent."
            },
            "submit": {
              "type": "boolean",
              "description": "If true (default), submit as Enter after pasting. If false, only paste into the composer.",
              "default": true
            },
            "workspaceHash": {
              "type": "string",
              "description": "Optional Tachyon workspace hash when multiple workspaces are open."
            }
          },
          "required": [
            "agent",
            "text"
          ]
        }
      }
