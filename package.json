{
  "name": "tachyon-workspace",
  "version": "0.91.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "generate:theme-tokens": "node scripts/generate-theme-tokens.mjs",
    "check:theme-tokens": "node scripts/generate-theme-tokens.mjs --check",
    "build": "npm run generate:theme-tokens && node scripts/build-engine-channel.mjs dev",
    "build:stable": "npm run generate:theme-tokens && node scripts/build-engine-channel.mjs stable",
    "watch": "npm run generate:theme-tokens && node scripts/build-engine-channel.mjs dev --watch",
    "typecheck": "tsc -b packages/shared packages/engine packages/webview-ui --pretty false && tsc --noEmit && tsc -p tsconfig.webview.json && tsc -p tsconfig.browser-test.json",
    "check:package-boundary": "node scripts/check-package-boundary.mjs",
    "check:engine-boundary": "bash scripts/check-engine-boundary.sh",
    "check:source-diffable": "node scripts/check-source-diffable.mjs",
    "check:webview-tokens": "node scripts/check-webview-tokens.mjs",
    "hygiene:scan": "node scripts/code-hygiene/scan.mjs",
    "disk:vscode-test": "vite-node --script scripts/vscode-test-disk.ts",
    "plugin:validate": "node scripts/run-extension-dist.mjs plugin-validate.cjs",
    "check:runtime-observability-reference": "node scripts/runtime-observability-reference.mjs",
    "record:provenance": "node scripts/record-provenance.mjs",
    "test": "vitest run",
    "verify:full": "node scripts/run-workspace-script.mjs scripts/verify-full.mjs",
    "verify:full:quiet": "node scripts/run-workspace-script.mjs scripts/verify-full.mjs",
    "verify:prepare": "npm ci --ignore-scripts --prefer-offline --no-audit --no-fund && npm run build",
    "runtime:remeasure": "node scripts/dogfood/run.mjs runtime-remeasure",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:integration": "vscode-test",
    "vscode:prepublish": "npm run package:assert",
    "package:assert": "node scripts/prepare-package.mjs",
    "release": "node scripts/release.mjs",
    "package": "node scripts/release.mjs",
    "smoke:vsix": "node scripts/vsix-smoke.mjs"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.2",
    "@types/katex": "^0.16.8",
    "@types/markdown-it": "^14.1.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/tar-stream": "^3.1.4",
    "@types/vscode": "^1.96.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1",
    "axe-core": "4.12.1",
    "esbuild": "^0.25.0",
    "mocha": "^11.0.0",
    "puppeteer-core": "25.3.0",
    "tailwindcss": "4.3.2",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
