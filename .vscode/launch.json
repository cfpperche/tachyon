{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Tachyon: Dev Host",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "${workspaceFolder}/.tachyon/dev-host/active/workspace",
        "--extensionDevelopmentPath=${workspaceFolder}/.tachyon/dev-host/active/extension",
        "--disable-workspace-trust"
      ],
      "env": {
        "TACHYON_DEV_HOST": "1",
        "TACHYON_DEV_HOST_ENGINE_RUNTIME": "${workspaceFolder}/.tachyon/dev-host/active/runtime",
        "TACHYON_DEV_HOST_PROFILE_HOME": "${workspaceFolder}/.tachyon/dev-host/active/profile-home",
        "TMUX_TMPDIR": "${workspaceFolder}/.tachyon/dev-host/active/tmux",
        "XDG_CACHE_HOME": "${workspaceFolder}/.tachyon/dev-host/active/cache",
        "XDG_STATE_HOME": "${workspaceFolder}/.tachyon/dev-host/active/state",
        "XDG_DATA_HOME": "${workspaceFolder}/.tachyon/dev-host/active/data"
      },
      "outFiles": [
        "${workspaceFolder}/.tachyon/dev-host/active/extension/dist/**/*.js"
      ],
      "preLaunchTask": "tachyon: build-dev-host",
      "presentation": {
        "hidden": false,
        "group": "dogfood",
        "order": 1
      }
    },
    {
      "name": "Run Tachyon (demo)",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "${env:HOME}/tachyon-examples",
        "--extensionDevelopmentPath=${workspaceFolder}"
      ],
      "outFiles": [
        "${workspaceFolder}/dist/**/*.js"
      ],
      "preLaunchTask": "tachyon: build"
    },
    {
      "name": "Run Tachyon (multi-root demo)",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "${env:HOME}/tachyon-examples/orbit.code-workspace",
        "--extensionDevelopmentPath=${workspaceFolder}"
      ],
      "outFiles": [
        "${workspaceFolder}/dist/**/*.js"
      ],
      "preLaunchTask": "tachyon: build"
    },
    {
      "name": "Run Tachyon (test fixture)",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "${workspaceFolder}/test/fixtures/sample-workspace",
        "--extensionDevelopmentPath=${workspaceFolder}"
      ],
      "outFiles": [
        "${workspaceFolder}/dist/**/*.js"
      ],
      "preLaunchTask": "tachyon: build"
    }
  ]
}
