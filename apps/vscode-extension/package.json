    "chatParticipants": [
      {
        "id": "tachyon.chat",
        "name": "tachyon",
        "fullName": "Tachyon",
        "description": "Send prompts to Tachyon workspace agents (fleet bridge)",
        "isSticky": true,
        "commands": [
          {
            "name": "list",
            "description": "List agents in the active Tachyon workspace"
          },
          {
            "name": "send",
            "description": "Send a prompt: /send <agent> <message>"
          },
          {
            "name": "help",
            "description": "How to use @tachyon"
          }
        ]
      }
    ],
    "languageModelTools": [
      {
        "name": "tachyon_list_agents",
        "tags": [
          "tachyon",
          "agents"
        ],
        "toolReferenceName": "tachyon_list_agents",
        "displayName": "Tachyon: List Agents",
        "userDescription": "List Tachyon agents in the active workspace",
        "modelDescription": "List agents managed by Tachyon in the current workspace (name, kind, lifetime, running). Use before sending a prompt when the agent name is unknown. Does not start agents.",
        "canBeReferencedInPrompt": true,
        "icon": "$(organization)",
        "inputSchema": {
          "type": "object",
          "properties": {}
        }
      },
      {
        "name": "tachyon_send_prompt",
        "tags": [
          "tachyon",
          "agents"
        ],
        "toolReferenceName": "tachyon_send_prompt",
        "displayName": "Tachyon: Send Prompt",
        "userDescription": "Send a prompt to a named Tachyon agent",
        "modelDescription": "Deliver text to a named Tachyon workspace agent (CLI running in a worktree via the Tachyon engine). Use when the user wants a Tachyon agent (e.g. grok, claude, codex) to act. Requires agent name and message text. Prefer list agents first if the name is unclear. This does not control the VS Code Integrated Browser; it only types into the agent session.",
        "canBeReferencedInPrompt": true,
        "icon": "$(rocket)",
        "inputSchema": {
          "type": "object",
          "properties": {
            "agent": {
              "type": "string",
              "description": "Exact Tachyon agent name (from tachyon_list_agents)."
            },
            "text": {
              "type": "string",
              "description": "Prompt text to deliver to the agent."
            },
            "submit": {
              "type": "boolean",
              "description": "If true (default), submit as Enter after pasting. If false, only paste into the composer.",
              "default": true
            },
            "workspaceHash": {
              "type": "string",
              "description": "Optional Tachyon workspace hash when multiple workspaces are open."
            }
          },
          "required": [
            "agent",
            "text"
          ]
        }
      }
    ]
