        "fileMatch": [
          ".tachyon/settings.yml"
        ],
        "url": "./dist/tachyon.schema.json"
      },
      {
        "fileMatch": [
          ".tachyon/terminals/*.yml"
        ],
        "url": "./dist/tachyon-terminal.schema.json"
      },
      {
        "fileMatch": [
          ".tachyon/schedules/*.yml"
        ],
        "url": "./dist/tachyon-schedule.schema.json"
      }
