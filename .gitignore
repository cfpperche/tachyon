node_modules
dist/
.vscode-test/
*.vsix
.vqa/

# Regenerated build artifact: embed step writes this before every vsce package (t-dcf9a2).
# .vscodeignore's `!provenance.json` still ships it in the VSIX — gitignore doesn't affect packaging.
# NOT anchored to the root: the manifest moved to apps/vscode-extension in SDD 506, so the embed step
# writes it beside whichever manifest is being packaged. An anchored `/provenance.json` silently
# stopped matching and the stable build refused a "dirty" tree until this was found.
provenance.json

# Tachyon per-workspace runtime state (pins, handoff, spawn-settings, activity,
# continuity, probes...). Machine/path-specific and auto-regenerated — local only.
.tachyon/

# Plugin-MATERIALIZED runtime dirs. Capabilities (e.g. SDD) come from INSTALLED
# plugins, never committed source — install reproduces them from the lockfile, so
# committing them would re-bake a capability into the repo and defeat "the plugin
# is the only path". The plugin engine writes skills/hooks/MCP here per runtime:
#   .claude/  -> claude (.claude/skills, .claude/settings.json, .mcp.json)
#   .agents/  -> codex skills (.agents/skills)
#   .codex/   -> codex hooks + MCP (.codex/hooks.json, .codex/config.toml)
#   .grok/    -> grok hooks (.grok/hooks/tachyon-plugins.json), .grok/skills
.claude/
.agents/
.codex/
.grok/
.mcp.json

# Legacy root config (retired by t-a65335; the migration bridge that used to fold one into
# .tachyon/settings.yml is gone since t-987825). Nothing reads or writes it — a file with this name
# does nothing at all now. Kept ignored so one left in an old checkout never lands in git.
tachyon.yml
tachyon.yaml

# Dogfood fixtures are workspaces on purpose, so all four rules above hit them — and they swallowed
# every fixture's `tachyon.yml`, plugin payload and materialized skills, leaving
# `test/fixtures/<slug>/` shipping a README and nothing that runs. Tests passed locally because the
# untracked files were on the author's disk; a fresh clone got an empty workspace and the failure
# read like a product regression. A fixture's declared workspace is SOURCE.
#
# `.tachyon/` is re-opened and then re-closed, because most of what lands in it is exactly the
# runtime state the rule was written for — activity/, *.sqlite3, sessions, continuity, config.lkg,
# tasks a local run wrote. Only the plugin-install shape is source, so only that is named.
!test/fixtures/**/.claude/
!test/fixtures/**/.agents/
!test/fixtures/**/.grok/
!test/fixtures/**/.tachyon/
test/fixtures/**/.tachyon/*
!test/fixtures/**/.tachyon/plugins/
!test/fixtures/**/.tachyon/plugins.lock.json
!test/fixtures/**/.tachyon/vscode-settings-import.json
# t-a65335 — the fixture's declared workspace is SOURCE: settings + per-file declarations.
!test/fixtures/**/.tachyon/settings.yml
!test/fixtures/**/.tachyon/terminals/
!test/fixtures/**/.tachyon/terminals/**
!test/fixtures/**/.tachyon/schedules/
!test/fixtures/**/.tachyon/schedules/**
# Canonical agent profiles shipped with dogfood fixtures (SDD 478 pointers under agents:).
!test/fixtures/**/.tachyon/agents/
!test/fixtures/**/.tachyon/agents/**
